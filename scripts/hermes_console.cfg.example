# hermes_console.cfg — copy next to hermes_bridge.ps1 / hermes_tray.ps1 on the SERVER
# (same folder) to override defaults. All keys optional; env HERMES_* wins over this file.
#
# BIND=127.0.0.1   address the bridge LISTENS on. Keep loopback unless you have a reason;
#                  any local address is allowed (e.g. a Tailscale IP when the tunnel is
#                  realized differently and does not land on loopback).
# PORT=18799       TCP port of TAB 1 (bridge listens here; the tray connects here too).
#                  Tab N listens on PORT+N-1.
# TABS=8           how many tabs the tray may keep open (default 8).
# WORKDIR=E:\AI    working directory of the visible console.
# BRIDGE_BIND=     optional: address the TRAY uses to reach the bridge (default = BIND).

BIND=127.0.0.1
PORT=18799
TABS=8
WORKDIR=E:\AI
